# ── Base de datos (Railway la provee automáticamente) ─────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ── Servidor ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET="cambia_esto_por_un_secreto_seguro_minimo_32_chars"
JWT_EXPIRES_IN="7d"
